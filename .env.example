# LLM — script generation (default: Google Gemini)
# Get a key at https://aistudio.google.com/apikey
# IMPORTANT: no quotes, no spaces around '='
GEMINI_API_KEY=
LLM_PROVIDER=gemini                        # gemini | groq | openai | anthropic
LLM_MODEL=gemini-1.5-flash

# Optional alternate LLM providers
GROQ_API_KEY=
OPENAI_API_KEY=                            # used for OpenAI TTS / optional DALL-E
ANTHROPIC_API_KEY=

# TTS
TTS_PROVIDER=edge-tts                      # openai | elevenlabs | gtts | edge-tts
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
EDGE_TTS_VOICE=en-US-ChristopherNeural
EDGE_TTS_RATE=-20%
# Must include a sign: -20% (slower) or +10% (faster). Bare "8%" is invalid for edge-tts.
EDGE_TTS_PITCH=+2Hz
EDGE_TTS_VOLUME=+0%
EDGE_TTS_SCENE_PAUSE_MS=450

# Asset providers:
#   gemini_image  -> Gemini native image (default product path; needs GEMINI_API_KEY)
#   pollinations  -> free pollinations.ai images (no key)
#   openai_image  -> OpenAI DALL-E 3 (OPENAI_API_KEY)
#   imagen        -> alias for gemini_image
#   manual        -> skip auto image gen (Flow / upload only)
ASSET_PROVIDER=gemini_image
OPENAI_IMAGE_MODEL=dall-e-3
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Pipeline defaults (asset-only — no MoviePy compile)
OUTPUT_DIR=./output
ASSETS_CACHE_DIR=./assets_cache
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
DEFAULT_STYLE=cinematic
LOG_LEVEL=INFO

# Async API / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STATIC_DIR=./static
CORS_ALLOW_ORIGINS=*
