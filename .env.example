# LLM — script generation (default: Groq free tier via OpenAI-compatible API)
# Get a free key at https://console.groq.com/keys
# IMPORTANT: no quotes, no spaces around '=' — example:
# GROQ_API_KEY=gsk_abc123...
GROQ_API_KEY=
LLM_PROVIDER=groq                          # groq | openai | anthropic
LLM_MODEL=llama-3.3-70b-versatile

# Optional alternate LLM providers
OPENAI_API_KEY=                            # used for OpenAI TTS / optional DALL-E
ANTHROPIC_API_KEY=

# TTS
TTS_PROVIDER=openai                        # openai | elevenlabs | gtts | edge-tts
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Used when TTS_PROVIDER=edge-tts (Microsoft Edge neural voices)
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Asset providers — generative AI only (stock Pixabay/Pexels removed):
#   pollinations  -> free pollinations.ai images from each scene.visual_prompt (default, no key)
#   openai_image  -> OpenAI DALL-E 3 only (requires OPENAI_API_KEY)
ASSET_PROVIDER=pollinations                # pollinations | openai_image
OPENAI_IMAGE_MODEL=dall-e-3

# Pipeline defaults
OUTPUT_DIR=./output
ASSETS_CACHE_DIR=./assets_cache
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
DEFAULT_STYLE=cinematic
LOG_LEVEL=INFO
