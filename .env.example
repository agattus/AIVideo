# LLM — script generation (default: Google Gemini)
# Get a key at https://aistudio.google.com/apikey
# IMPORTANT: no quotes, no spaces around '='
GEMINI_API_KEY=
LLM_PROVIDER=gemini                        # gemini | groq | openai | anthropic
LLM_MODEL=gemini-1.5-flash

# Optional alternate LLM providers
GROQ_API_KEY=
OPENAI_API_KEY=                            # used for OpenAI TTS / optional DALL-E
ANTHROPIC_API_KEY=

# TTS
TTS_PROVIDER=edge-tts                      # openai | elevenlabs | gtts | edge-tts
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Asset providers:
#   pollinations  -> free pollinations.ai images (default, no key)
#   openai_image  -> OpenAI DALL-E 3 only (requires OPENAI_API_KEY)
#   imagen        -> Google Imagen / Gemini image generation
#   manual        -> human-in-the-loop ZIP upload (no auto image gen)
ASSET_PROVIDER=pollinations
OPENAI_IMAGE_MODEL=dall-e-3

# Pipeline defaults (asset-only — no MoviePy compile)
OUTPUT_DIR=./output
ASSETS_CACHE_DIR=./assets_cache
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
DEFAULT_STYLE=cinematic
LOG_LEVEL=INFO

# Async API / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STATIC_DIR=./static
CORS_ALLOW_ORIGINS=*
