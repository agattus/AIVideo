# LLM — script generation (default: Groq free tier via OpenAI-compatible API)
# Get a free key at https://console.groq.com/keys
# IMPORTANT: no quotes, no spaces around '=' — example:
# GROQ_API_KEY=gsk_abc123...
GROQ_API_KEY=
LLM_PROVIDER=groq                          # groq | openai | anthropic
LLM_MODEL=llama-3.3-70b-versatile

# Optional alternate LLM providers
OPENAI_API_KEY=                            # used for OpenAI TTS / optional DALL-E
ANTHROPIC_API_KEY=

# Google Gemini / Imagen (required when ASSET_PROVIDER=imagen)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
IMAGEN_MODEL=imagen-3.0-generate-002

# TTS
TTS_PROVIDER=openai                        # openai | elevenlabs | gtts | edge-tts
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Used when TTS_PROVIDER=edge-tts (Microsoft Edge neural voices)
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Asset providers — generative AI only (stock Pixabay/Pexels removed):
#   imagen        -> Google Imagen 3 via google-genai (default, requires GEMINI_API_KEY)
#   pollinations  -> free pollinations.ai images from each scene.visual_prompt (no key)
#   openai_image  -> OpenAI DALL-E 3 only (requires OPENAI_API_KEY)
ASSET_PROVIDER=imagen                      # imagen | pollinations | openai_image
OPENAI_IMAGE_MODEL=dall-e-3

# Pipeline defaults
OUTPUT_DIR=./output
ASSETS_CACHE_DIR=./assets_cache
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
DEFAULT_STYLE=cinematic
LOG_LEVEL=INFO

# Async API / Celery
# Local (CLI / uvicorn on host): use localhost
# Docker Compose overrides these to redis://redis:6379/...
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STATIC_DIR=./static
CORS_ALLOW_ORIGINS=*

# IMPORTANT after merging main:
#   ASSET_PROVIDER=pixabay|pexels is deprecated → remapped to pollinations
# Recommended high-quality local stack:
#   GROQ_API_KEY=gsk_...
#   GEMINI_API_KEY=...
#   TTS_PROVIDER=edge-tts
#   ASSET_PROVIDER=imagen
