# LLM — script generation (default: Groq free tier via OpenAI-compatible API)
# Get a free key at https://console.groq.com/keys
# IMPORTANT: no quotes, no spaces around '=' — example:
# GROQ_API_KEY=gsk_abc123...
GROQ_API_KEY=
LLM_PROVIDER=groq                          # groq | openai | anthropic
LLM_MODEL=llama-3.3-70b-versatile

# Optional alternate LLM providers
OPENAI_API_KEY=                            # still used for TTS + DALL-E fallback
ANTHROPIC_API_KEY=

# TTS
TTS_PROVIDER=openai                        # openai | elevenlabs | gtts
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Asset providers — ASSET_PROVIDER selects the exclusive routing:
#   pexels       -> Pexels video -> Pexels image -> OpenAI DALL-E 3
#   pixabay      -> Pixabay video -> Pixabay image (no Pexels/OpenAI)
#   openai_image -> OpenAI DALL-E 3 only
ASSET_PROVIDER=pixabay                     # pexels | pixabay | openai_image
PIXABAY_API_KEY=
PEXELS_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Pipeline defaults
OUTPUT_DIR=./output
ASSETS_CACHE_DIR=./assets_cache
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
DEFAULT_STYLE=cinematic
LOG_LEVEL=INFO
