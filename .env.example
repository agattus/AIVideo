# LLM — script generation (default: Google Gemini)
# Get a key at https://aistudio.google.com/apikey
# IMPORTANT: no quotes, no spaces around '='
GEMINI_API_KEY=
LLM_PROVIDER=gemini                        # gemini | groq | openai | anthropic
LLM_MODEL=gemini-1.5-flash

# Optional alternate LLM providers
GROQ_API_KEY=
OPENAI_API_KEY=                            # used for OpenAI TTS / optional DALL-E
ANTHROPIC_API_KEY=

# Google Imagen 3 (same GEMINI_API_KEY; required when ASSET_PROVIDER=imagen)
IMAGEN_MODEL=imagen-3.0-generate-002

# TTS
TTS_PROVIDER=edge-tts                      # openai | elevenlabs | gtts | edge-tts
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Asset providers — generative AI only (stock Pixabay/Pexels removed):
#   imagen        -> Google Imagen 3 via google-genai (default, requires GEMINI_API_KEY)
#   pollinations  -> free pollinations.ai images from each scene.visual_prompt (no key)
#   openai_image  -> OpenAI DALL-E 3 only (requires OPENAI_API_KEY)
ASSET_PROVIDER=imagen                      # imagen | pollinations | openai_image
OPENAI_IMAGE_MODEL=dall-e-3

# Pipeline defaults — cinematic automated assembly (MoviePy)
OUTPUT_DIR=./output
ASSETS_CACHE_DIR=./assets_cache
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
DEFAULT_STYLE=cinematic
SCENE_CROSSFADE_SECONDS=0.45
KEN_BURNS_ZOOM=0.12
BGM_VOLUME=0.10
BGM_FADE_SECONDS=1.5
VOICEOVER_VOLUME=1.05
LOG_LEVEL=INFO

# Async API / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STATIC_DIR=./static
CORS_ALLOW_ORIGINS=*

# Recommended cinematic stack:
#   GEMINI_API_KEY=...
#   TTS_PROVIDER=edge-tts
#   ASSET_PROVIDER=imagen
#   DEFAULT_STYLE=cinematic
