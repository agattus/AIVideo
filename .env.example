# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai          # openai | anthropic
LLM_MODEL=gpt-4o

# TTS
TTS_PROVIDER=openai          # openai | elevenlabs
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Asset providers
ASSET_PROVIDER=pexels        # pexels | pixabay | openai_image
PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Pipeline defaults
OUTPUT_DIR=./output
ASSETS_CACHE_DIR=./assets_cache
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
DEFAULT_STYLE=cinematic
LOG_LEVEL=INFO
